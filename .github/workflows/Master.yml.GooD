# GitHub Actions Workflow for building the HoloXlife Ada OS
name: HoloXlife OS Build

# This workflow runs on every push or pull request to the 'main' branch
on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  # The 'build' job runs on a fresh Ubuntu virtual machine
  build:
    runs-on: ubuntu-latest

    steps:
      # Step 1: Check out the repository's code
      - name: Checkout repository
        uses: actions/checkout@v4

      # Step 2: Install build dependencies
      - name: Install Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y nasm gcc-10 gnat-10 qemu-system-i386 make

      # Step 3: Build the OS image
      - name: Build emergeos.img
        run: make all

      # Step 4: Run a quick "smoke test"
      - name: Run Smoke Test in QEMU
        run: |
          timeout 15s make run || true
          echo "Smoke test complete. Checking for log files..."

      # Step 5: Upload comprehensive build artifacts
      # This packages the final image, all logs, and all source code into a
      # single zip file. This allows for complete cross-referencing of a build.
      - name: Upload Build Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: HoloXlife-OS-Build-Package
          path: |
            # The final, bootable OS image
            emergeos.img
            
            # All log files generated by the build and test run
            *.log
            
            # All Ada source and specification files
            *.ads
            *.adb
            
            # The bootloader source code
            boot.asm
            
            # The build and linker scripts
            Makefile
            linker.ld
            
            # The generated Ada configuration file
            gnat.adc
